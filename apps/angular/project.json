{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "app-angular",
  "projectType": "application",
  "sourceRoot": "apps/angular/src",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": ["sdk-angular:build"],
      "options": {
        "outputPath": "apps/angular/dist",
        "browser": "apps/angular/src/main.ts",
        "tsConfig": "apps/angular/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/angular/public"
          }
        ],
        "styles": ["@strivacity/common/styles/globals.css"],
        "server": "apps/angular/src/main.server.ts",
        "outputMode": "server",
        "security": {
          "allowedHosts": []
        },
        "ssr": {
          "entry": "apps/angular/src/server/server.ts"
        }
      },
      "configurations": {
        "production": {},
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "dependsOn": ["sdk-angular:build"],
      "configurations": {
        "production": {
          "buildTarget": "app-angular:build:production"
        },
        "development": {
          "buildTarget": "app-angular:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "dependsOn": ["sdk-angular:build"]
    }
  }
}
