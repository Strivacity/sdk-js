{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "app-angular-bff",
  "projectType": "application",
  "sourceRoot": "apps/angular-bff/src",
  "targets": {
    "build": {
      "builder": "",
      "executor": "@angular-builders/custom-webpack:browser",
      "dependsOn": ["sdk-angular:build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "apps/angular-bff/dist",
        "deleteOutputPath": false,
        "index": "apps/angular-bff/src/index.html",
        "main": "apps/angular-bff/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/angular-bff/tsconfig.json",
        "customWebpackConfig": {
          "path": "apps/angular-bff/webpack.config.cjs"
        }
      },
      "configurations": {
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "executor": "@angular-builders/custom-webpack:dev-server",
      "dependsOn": ["sdk-angular:build"],
      "options": {
        "proxyConfig": "apps/angular-bff/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "app-angular-bff:build:production"
        },
        "development": {
          "buildTarget": "app-angular-bff:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "app-angular-bff:build",
        "port": 4200,
        "staticFilePath": "dist/apps/angular-bff/browser",
        "spa": true
      }
    }
  }
}
