{
  "name": "@strivacity/source",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm exec simple-git-hooks",
    "build": "nx run-many --target=build --projects=$(nx show projects | grep '^sdk-' | tr '\n' ',' | sed 's/,$//')",
    "test": "nx run-many --target=test",
    "test:ci": "nx run-many --target=test --coverage",
    "lint": "nx run-many --target=eslint",
    "format": "oxfmt",
    "release": "nx release --skip-publish",
    "app:analogjs:serve": "nx run app-analogjs:serve",
    "app:angular:serve": "nx run app-angular:serve",
    "app:preact:serve": "nx run app-preact:serve",
    "app:next:serve": "nx run app-next:serve",
    "app:nuxt:serve": "nx run app-nuxt:serve",
    "app:react:serve": "nx run app-react:serve",
    "app:sveltekit:serve": "nx run app-sveltekit:serve",
    "app:vue:serve": "nx run app-vue:serve",
    "sdk:angular:build": "nx run sdk-angular:build",
    "sdk:angular:test": "nx run sdk-angular:test",
    "sdk:core:build": "nx run sdk-core:build",
    "sdk:core:test": "nx run sdk-core:test",
    "sdk:next:build": "nx run sdk-next:build",
    "sdk:next:test": "nx run sdk-next:test",
    "sdk:nuxt:build": "nx run sdk-nuxt:build",
    "sdk:nuxt:test": "nx run sdk-nuxt:test",
    "sdk:preact:build": "nx run sdk-preact:build",
    "sdk:preact:test": "nx run sdk-preact:test",
    "sdk:react:build": "nx run sdk-react:build",
    "sdk:react:test": "nx run sdk-react:test",
    "sdk:remix:build": "nx run sdk-remix:build",
    "sdk:remix:test": "nx run sdk-remix:test",
    "sdk:svelte:build": "nx run sdk-svelte:build",
    "sdk:svelte:test": "nx run sdk-svelte:test",
    "sdk:vue:build": "nx run sdk-vue:build",
    "sdk:vue:test": "nx run sdk-vue:test"
  },
  "devDependencies": {
    "@analogjs/content": "^2.6.4",
    "@analogjs/platform": "^2.6.4",
    "@analogjs/router": "^2.6.4",
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@analogjs/vitest-angular": "^2.6.4",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/ssr": "^22.1.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@nx/eslint": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@preact/preset-vite": "^2.10.6",
    "@remix-run/node": "^2.17.5",
    "@strivacity/common": "*",
    "@strivacity/sdk-angular": "*",
    "@strivacity/sdk-core": "*",
    "@strivacity/sdk-next": "*",
    "@strivacity/sdk-nuxt": "*",
    "@strivacity/sdk-preact": "*",
    "@strivacity/sdk-react": "*",
    "@strivacity/sdk-remix": "*",
    "@strivacity/sdk-svelte": "*",
    "@strivacity/sdk-vue": "*",
    "@strivacity/testing": "*",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-vue": "^10.10.0",
    "express": "^5.1.0",
    "globals": "^17.11.0",
    "h3": "^1.15.11",
    "lint-staged": "^17.2.0",
    "luxon": "^3.7.2",
    "next": "^16.2.11",
    "ng-packagr": "^21.2.0",
    "nitropack": "^2.13.4",
    "nuxt": "^4.5.1",
    "nx": "23.1.0",
    "oxfmt": "^0.60.0",
    "preact": "^10.26.9",
    "preact-router": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "rxjs": "~7.8.0",
    "sass-embedded": "^1.100.0",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "unbuild": "^3.6.1",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit $1",
    "pre-commit": "pnpm exec lint-staged --concurrent false"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}